{
  "id": "com.universaltill.payment-sumup",
  "name": "SumUp Card Payments",
  "version": "1.9.2",
  "description": "Take card payments through SumUp. With a paired SumUp Solo reader (set sumup_reader_id), the till drives the reader directly for a real card-present tap/insert, and a tip the customer picks on the reader syncs back to the till automatically. With test mode switched on (sumup_test_mode) it runs in test mode: no card is charged and nothing is sent to SumUp (amounts ending .13 decline, .99 time out, anything else approves). Refunding a SumUp reader sale on the till refunds the original transaction automatically (a refund of a test-mode sale is approved with nothing to send back). Without a reader or with no API key a payment is declined, never approved as a test. Cards are charged in your shop's currency; the currency setting can pin it, and a choice that does not match the till's currency is declined rather than charged. Set your SumUp API key and merchant code in the settings; Universal Till's own SumUp affiliate key is built in, and the affiliate app id defaults to Universal Till's.",
  "author": "Universal Till",
  "website": "https://universaltill.com",
  "canonical_type": "payment",
  "runtime": "wasm",
  "device_arch": "any",
  "min_pos_version": "0.31.9",
  "permissions": [
    "pos.tender",
    "events:receive",
    "view:shop",
    "net:api.sumup.com",
    "storage",
    "blob:own"
  ],
  "locales": [
    "en-US",
    "de-DE",
    "tr-TR"
  ],
  "entries": [
    {
      "type": "payment",
      "key": "sumup",
      "label": "Card (SumUp)",
      "sort_order": 5,
      "trigger_event": "payment.sumup.requested"
    }
  ],
  "settings": [
    {
      "key": "sumup_api_key",
      "default_value": "",
      "scope": "global",
      "type": "secret",
      "label": "payment_sumup.api_key.label",
      "help": "payment_sumup.api_key.help"
    },
    {
      "key": "sumup_merchant_code",
      "default_value": "",
      "scope": "global",
      "label": "payment_sumup.merchant_code.label",
      "help": "payment_sumup.merchant_code.help"
    },
    {
      "key": "sumup_app_id",
      "default_value": "com.universaltill.pos",
      "scope": "global",
      "label": "payment_sumup.app_id.label",
      "help": "payment_sumup.app_id.help"
    },
    {
      "key": "currency",
      "default_value": "auto",
      "scope": "global",
      "label": "payment_sumup.currency.label",
      "type": "choice",
      "help": "payment_sumup.currency.help",
      "options": [
        {
          "value": "auto",
          "label": "payment_sumup.currency.opt.auto"
        },
        {
          "value": "aud",
          "label": "payment_sumup.currency.opt.aud"
        },
        {
          "value": "brl",
          "label": "payment_sumup.currency.opt.brl"
        },
        {
          "value": "cad",
          "label": "payment_sumup.currency.opt.cad"
        },
        {
          "value": "chf",
          "label": "payment_sumup.currency.opt.chf"
        },
        {
          "value": "czk",
          "label": "payment_sumup.currency.opt.czk"
        },
        {
          "value": "dkk",
          "label": "payment_sumup.currency.opt.dkk"
        },
        {
          "value": "eur",
          "label": "payment_sumup.currency.opt.eur"
        },
        {
          "value": "gbp",
          "label": "payment_sumup.currency.opt.gbp"
        },
        {
          "value": "mxn",
          "label": "payment_sumup.currency.opt.mxn"
        },
        {
          "value": "nok",
          "label": "payment_sumup.currency.opt.nok"
        },
        {
          "value": "pen",
          "label": "payment_sumup.currency.opt.pen"
        },
        {
          "value": "pln",
          "label": "payment_sumup.currency.opt.pln"
        },
        {
          "value": "ron",
          "label": "payment_sumup.currency.opt.ron"
        },
        {
          "value": "sek",
          "label": "payment_sumup.currency.opt.sek"
        },
        {
          "value": "usd",
          "label": "payment_sumup.currency.opt.usd"
        }
      ]
    },
    {
      "key": "sumup_test_mode",
      "default_value": "off",
      "scope": "global",
      "type": "choice",
      "label": "payment_sumup.test_mode.label",
      "help": "payment_sumup.test_mode.help",
      "options": [
        {
          "value": "off",
          "label": "payment_sumup.test_mode.opt.off"
        },
        {
          "value": "on",
          "label": "payment_sumup.test_mode.opt.on"
        }
      ]
    },
    {
      "key": "sumup_reader_id",
      "default_value": "",
      "scope": "register",
      "label": "payment_sumup.reader_id.label",
      "help": "payment_sumup.reader_id.help"
    }
  ],
  "entrypoint": "./bin/plugin.wasm",
  "hooks": [
    {
      "event": "payment.sumup.authorize",
      "action": "sumup.authorize"
    },
    {
      "event": "payment.sumup.requested",
      "action": "sumup.settled"
    },
    {
      "event": "payment.sumup.refund",
      "action": "sumup.refund"
    },
    {
      "event": "payment.sumup.readers",
      "action": "sumup.readers"
    }
  ],
  "views_used": [
    "shop.context.v2"
  ]
}
